{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "试卷封面与目录",
  "type": "object",
  "required": ["schema_version", "taxonomy_version", "id", "school", "title", "academic_year", "grade", "semester", "exam_type", "sources", "question_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "taxonomy_version": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "school": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "academic_year": {"type": "string"},
    "grade": {"type": "string"},
    "semester": {"type": "string"},
    "exam_type": {"type": "string"},
    "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sources": {
      "type": "object", "required": ["paper"],
      "properties": {"paper": {"$ref": "#/$defs/document"}, "solution": {"$ref": "#/$defs/document"}}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["git_path", "sha256", "rendered_pdf", "rendered_sha256", "print_page_count"],
      "properties": {
        "git_path": {"type": "string", "description": "原始文件相对 Git 仓库根的位置。"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rendered_pdf": {"type": "string", "description": "用于稳定定位页码的 PDF，相对题库目录。"},
        "rendered_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "print_page_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
