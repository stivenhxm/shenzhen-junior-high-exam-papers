        "\\(=\\frac { 1 } { \\frac { \\sqrt[] { 1 } } { 2 }+\\frac { \\sqrt[] { 2 } } { 2 } }+\\frac { 1 } { \\frac { \\sqrt[] { 2 } } { 2 }+\\frac { \\sqrt[] { 3 } } { 2 } }+\\frac { 1 } { \\frac { \\sqrt[] { 3 } } { 2 }+\\frac { \\sqrt[] { 4 } } { 2 } }+\\cdot \\cdot \\cdot +\\frac { 1 } { \\frac { \\sqrt[] { 99 } } { 2 }+\\frac { \\sqrt[] { 100 } } { 2 } }\\)",
        "\\(=\\frac { 1 } { \\frac { \\sqrt[] { 1 }+\\sqrt[] { 2 } } { 2 } }+\\frac { 1 } { \\frac { \\sqrt[] { 2 }+\\sqrt[] { 3 } } { 2 } }+\\frac { 1 } { \\frac { \\sqrt[] { 3 }+\\sqrt[] { 4 } } { 2 } }+\\cdot \\cdot \\cdot +\\frac { 1 } { \\frac { \\sqrt[] { 99 }+\\sqrt[] { 100 } } { 2 } }\\)",
        "\\(=\\frac { 2 } { \\sqrt[] { 1 }+\\sqrt[] { 2 } }+\\frac { 2 } { \\sqrt[] { 2 }+\\sqrt[] { 3 } }+\\frac { 2 } { \\sqrt[] { 3 }+\\sqrt[] { 4 } }+\\cdot \\cdot \\cdot +\\frac { 2 } { \\sqrt[] { 99 }+\\sqrt[] { 100 } }\\)",
        "\\(=2\\left ( { \\frac { 1 } { \\sqrt[] { 1 }+\\sqrt[] { 2 } }+\\frac { 1 } { \\sqrt[] { 2 }+\\sqrt[] { 3 } }+\\frac { 1 } { \\sqrt[] { 3 }+\\sqrt[] { 4 } }+\\cdot \\cdot \\cdot +\\frac { 1 } { \\sqrt[] { 99 }+\\sqrt[] { 100 } } } \\right )\\)",
        "\\(=2\\left ( { \\frac { \\left ( { \\sqrt[] { 2 }-\\sqrt[] { 1 } } \\right ) } { \\left ( { \\sqrt[] { 1 }+\\sqrt[] { 2 } } \\right )\\left ( { \\sqrt[] { 2 }-\\sqrt[] { 1 } } \\right ) }+\\frac { \\left ( { \\sqrt[] { 3 }-\\sqrt[] { 2 } } \\right ) } { \\left ( { \\sqrt[] { 2 }+\\sqrt[] { 3 } } \\right )\\left ( { \\sqrt[] { 3 }-\\sqrt[] { 2 } } \\right ) }+\\frac { \\left ( { \\sqrt[] { 4 }-\\sqrt[] { 3 } } \\right ) } { \\left ( { \\sqrt[] { 3 }+\\sqrt[] { 4 } } \\right )\\left ( { \\sqrt[] { 4 }-\\sqrt[] { 3 } } \\right ) }+\\cdot \\cdot \\cdot +\\frac { \\left ( { \\sqrt[] { 100 }-\\sqrt[] { 99 } } \\right ) } { \\left ( { \\sqrt[] { 99 }+\\sqrt[] { 100 } } \\right )\\left ( { \\sqrt[] { 100 }-\\sqrt[] { 99 } } \\right ) } } \\right )\\)",
        "\\(=2\\left ( { \\sqrt[] { 2 }-1+\\sqrt[] { 3 }-\\sqrt[] { 2 }+\\sqrt[] { 4 }-\\sqrt[] { 3 }+\\cdot \\cdot \\cdot +\\sqrt[] { 100 }-\\sqrt[] { 99 } } \\right )\\)",
