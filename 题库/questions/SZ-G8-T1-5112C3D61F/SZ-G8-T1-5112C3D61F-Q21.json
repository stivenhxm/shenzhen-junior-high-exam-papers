qrt[] { 3 }+\\sqrt[] { 4 } } \\right )\\left ( { \\sqrt[] { 4 }-\\sqrt[] { 3 } } \\right ) }+\\cdot \\cdot \\cdot +\\frac { \\left ( { \\sqrt[] { 100 }-\\sqrt[] { 99 } } \\right ) } { \\left ( { \\sqrt[] { 99 }+\\sqrt[] { 100 } } \\right )\\left ( { \\sqrt[] { 100 }-\\sqrt[] { 99 } } \\right ) } } \\right )\\)\n\\(=2\\left ( { \\sqrt[] { 2 }-1+\\sqrt[] { 3 }-\\sqrt[] { 2 }+\\sqrt[] { 4 }-\\sqrt[] { 3 }+\\cdot \\cdot \\cdot +\\sqrt[] { 100 }-\\sqrt[] { 99 } } \\right )\\)\n\\(=2\\left ( { \\sqrt[] { 100 }-1 } \\right )\\)\n\\(=2\\left ( { 10-1 } \\right )\\)\n\\(=18\\)．",
