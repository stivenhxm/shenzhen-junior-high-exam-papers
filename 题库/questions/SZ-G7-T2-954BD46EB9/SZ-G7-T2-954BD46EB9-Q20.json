\sqrt[] { 2 } } \\right )\\left ( { \\sqrt[] { 2 }-1 } \\right ) }+\\frac { 2\\left ( { \\sqrt[] { 3 }-\\sqrt[] { 2 } } \\right ) } { \\left ( { \\sqrt[] { 2 }+\\sqrt[] { 3 } } \\right )\\left ( { \\sqrt[] { 3 }-\\sqrt[] { 2 } } \\right ) }+\\frac { 2\\left ( { 2-\\sqrt[] { 3 } } \\right ) } { \\left ( { \\sqrt[] { 3 }+2 } \\right )\\left ( { 2-\\sqrt[] { 3 } } \\right ) }+\\frac { 2\\left ( { \\sqrt[] { 5 }-2 } \\right ) } { \\left ( { 2+\\sqrt[] { 5 } } \\right )\\left ( { \\sqrt[] { 5 }-2 } \\right ) }\\)，\n\\(=2\\left ( { \\sqrt[] { 2 }-1+\\sqrt[] { 3 }-\\sqrt[] { 2 }+2-\\sqrt[] { 3 }+\\sqrt[] { 5 }-2 } \\right )\\)\n\\(=2\\sqrt[] { 5 }-2\\).",
