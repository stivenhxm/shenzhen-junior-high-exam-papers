      "label": "C",
      "text": "\\((3x) ^ { 2 } =(7x-10) ^ { 2 } +(10) ^ { 2 }\\)"
    },
    {
      "label": "D",
      "text": "\\((7x+10) ^ { 2 } =10 ^ { 2 } +(3x) ^ { 2 }\\)"
    }
  ],
