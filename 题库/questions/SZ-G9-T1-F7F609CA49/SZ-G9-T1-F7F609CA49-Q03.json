  "title": "选取适当方法解一元二次方程",
  "stem": "一元二次方程\\({x}^{2}−3x=0\\)的解是(    )",
  "choices": [
    {
      "label": "A",
      "text": "\\({x}_{1}=0\\)，\\({x}_{2}=−3\\)"
