    "=1-\\(\\frac { 1 } { 2020 }\\)",
    "=\\(\\frac { 2019 } { 2020 }\\)",
    "②∵\\(\\frac { 1 } { 1\\times 3 }=\\frac { 1 } { 3 }=\\frac { 1 } { 2 }\\times (1-\\frac { 1 } { 3 })\\)，\\(\\frac { 1 } { 3\\times 5 }=\\frac { 1 } { 15 }=\\frac { 1 } { 2 }\\times (\\frac { 1 } { 3 }-\\frac { 1 } { 5 })\\)…，",
    "∴\\(\\frac { 1 } { 1\\times 3 }+\\frac { 1 } { 3\\times 5 }+\\frac { 1 } { 5\\times 7 }+...+\\frac { 1 } { 49\\times 51 }\\)",
    "=\\(\\frac { 1 } { 2 }\\times (1-\\frac { 1 } { 3 })\\)+\\(\\frac { 1 } { 2 }\\times (\\frac { 1 } { 3 }-\\frac { 1 } { 5 })\\)+…+\\(\\frac { 1 } { 2 }\\times (\\frac { 1 } { 49 }-\\frac { 1 } { 51 })\\)",
    "=\\(\\frac { 1 } { 2 }\\times (1-\\frac { 1 } { 3 }+\\frac { 1 } { 3 }-\\frac { 1 } { 5 }+...+\\frac { 1 } { 49 }-\\frac { 1 } { 51 })\\)",
    "=\\(\\frac { 1 } { 2 }\\times (1-\\frac { 1 } { 51 })\\)",
    "=\\(\\frac { 1 } { 2 }\\times \\frac { 50 } { 51 }\\)",
    "=\\(\\frac { 25 } { 51 }\\)"
