      "requires": [],
      "given_answer": "",
      "answer": "\\(3\\)。",
      "given_solution": "解：（1）∵\\(a=\\sqrt[] { 5 }，b=3，c=2\\sqrt[] { 5 }\\)，\n∴\\(p=\\frac { \\sqrt[] { 5 }+3+2\\sqrt[] { 5 } } { 2 }=\\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\)，（1分）\n∴\\(S=\\sqrt[] { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\times \\left ( { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }-\\sqrt[] { 5 } } \\right )\\times \\left ( { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }-3 } \\right )\\times \\left ( { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }-2\\sqrt[] { 5 } } \\right ) }\\)，\n\\(=\\sqrt[] { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\times \\frac { \\sqrt[] { 5 }+3 } { 2 }\\times \\frac { 3\\sqrt[] { 5 }-3 } { 2 }\\times \\frac { 3-\\sqrt[] { 5 } } { 2 } }\\)，\n\\(=\\sqrt[] { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\times \\frac { 3\\sqrt[] { 5 }-3 } { 2 }\\times \\frac { \\sqrt[] { 5 }+3 } { 2 }\\times \\frac { 3-\\sqrt[] { 5 } } { 2 } }\\)，\n\\(=\\sqrt[] { \\frac { \\left ( { 3\\sqrt[] { 5 } } \\right ) ^ { 2 } -3 ^ { 2 } } { 4 }\\times \\frac { 3 ^ { 2 } -\\left ( { \\sqrt[] { 5 } } \\right ) ^ { 2 } } { 4 } }\\)，\n\\(=\\sqrt[] { \\frac { 36 } { 4 }\\times \\frac { 4 } { 4 } }\\)，\n\\(=\\sqrt[] { 9 }\\)，\n\\(=3\\)；（2分）",
      "solution_steps": [
        "解：（1）∵\\(a=\\sqrt[] { 5 }，b=3，c=2\\sqrt[] { 5 }\\)，",
        "∴\\(p=\\frac { \\sqrt[] { 5 }+3+2\\sqrt[] { 5 } } { 2 }=\\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\)，（1分）",
        "∴\\(S=\\sqrt[] { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\times \\left ( { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }-\\sqrt[] { 5 } } \\right )\\times \\left ( { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }-3 } \\right )\\times \\left ( { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }-2\\sqrt[] { 5 } } \\right ) }\\)，",
        "\\(=\\sqrt[] { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\times \\frac { \\sqrt[] { 5 }+3 } { 2 }\\times \\frac { 3\\sqrt[] { 5 }-3 } { 2 }\\times \\frac { 3-\\sqrt[] { 5 } } { 2 } }\\)，",
        "\\(=\\sqrt[] { \\frac { 3\\sqrt[] { 5 }+3 } { 2 }\\times \\frac { 3\\sqrt[] { 5 }-3 } { 2 }\\times \\frac { \\sqrt[] { 5 }+3 } { 2 }\\times \\frac { 3-\\sqrt[] { 5 } } { 2 } }\\)，",
        "\\(=\\sqrt[] { \\frac { \\left ( { 3\\sqrt[] { 5 } } \\right ) ^ { 2 } -3 ^ { 2 } } { 4 }\\times \\frac { 3 ^ { 2 } -\\left ( { \\sqrt[] { 5 } } \\right ) ^ { 2 } } { 4 } }\\)，",
        "\\(=\\sqrt[] { \\frac { 36 } { 4 }\\times \\frac { 4 } { 4 } }\\)，",
        "\\(=\\sqrt[] { 9 }\\)，",
        "\\(=3\\)；（2分）"
      ],
