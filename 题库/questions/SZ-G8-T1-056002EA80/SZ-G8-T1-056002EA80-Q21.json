        "\\(=\\frac { \\sqrt[] { 3 }-1 } { 2 }+\\frac { \\sqrt[] { 5 }-\\sqrt[] { 3 } } { 2 }+\\frac { \\sqrt[] { 7 }-\\sqrt[] { 5 } } { 2 }+\\ldots +\\frac { \\sqrt[] { 21 }-\\sqrt[] { 19 } } { 2 }\\)",
        "\\(=\\frac { 1 } { 2 }\\left ( { \\sqrt[] { 3 }-1+\\sqrt[] { 5 }-\\sqrt[] { 3 }+\\sqrt[] { 7 }-\\sqrt[] { 5 }+\\ldots +\\sqrt[] { 21 }-\\sqrt[] { 19 } } \\right )\\)",
        "\\(=\\frac { 1 } { 2 }\\left ( { \\sqrt[] { 21 }-1 } \\right )\\)",
        "\\(=\\frac { \\sqrt[] { 21 }-1 } { 2 }\\)"
