      "text": "\\(\\begin{cases} x=y-100 \\\\ \\frac { x } { 100 }=\\frac { y } { 60 } \\end{cases}\\)"
    },
    {
      "label": "D",
      "text": "\\(\\begin{cases} x=y-100 \\\\ \\frac { x } { 100 }=\\frac { y } { 60 } \\end{cases}\\)"
    }
  ],
  "figures": [],
